<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:lineSpacingExtra="6dp" />
        <Button android:id="@+id/water" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tưới cỏ" />
        <Button android:id="@+id/refill" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bơm giếng (5 xu)" />
        <Button android:id="@+id/collect" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nhặt trứng" />
        <Button android:id="@+id/sell" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cho xe đi bán (10 xu/trứng)" />
        <Button android:id="@+id/buy" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mua gà (100 xu)" />
        <Button android:id="@+id/speed" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Debug" />
        <Button android:id="@+id/reset" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Chơi lại từ đầu" />
    </LinearLayout>
</ScrollView>
